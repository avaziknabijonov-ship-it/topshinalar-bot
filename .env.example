# A NEW, SEPARATE token for the TOPSHINALAR employee bot.
# Never reuse a MasterCoffee token. Do not commit real secrets.
BOT_TOKEN=
# Telegram numeric IDs, comma separated. Maximum 3 directors; employees are not capped.
DIRECTOR_IDS=
EMPLOYEE_IDS=
DB_PATH=data/topshinalar.sqlite3
PDF_FONT=/usr/share/fonts/truetype/dejavu/DejaVuSans.ttf
# Optional Mini App: the HTTPS origin after domain and server setup.
PUBLIC_APP_URL=
MINIAPP_HOST=127.0.0.1
MINIAPP_PORT=8080
# Optional debt-payment alerts: ONE explicitly chosen active director's private Telegram ID.
# Empty = disabled. No fallback/broadcast; use the same value for bot and Mini App services.
DIRECTOR_DEBT_CHAT_ID=

# Optional private company PDFs: absolute directory OUTSIDE the checkout/web root.
# Empty = disabled. Files are available only to authenticated active staff/directors.
COMPANY_DOCUMENTS_DIR=

# Optional director group with topics: Prixod / Kassa / O'tkazma notices (bot service only).
# Format: <group_chat_id> or <group_chat_id>:<topic_id>. Empty = that category is off.
# The group must be private and contain only the bot and active directors.
NOTIFY_PRIXOD=
NOTIFY_KASSA=
NOTIFY_OTKAZMA=
# uz or ru
NOTIFY_LANG=uz
# 0 = do not add the bundled tyre list on start (use after wiping the database)
CATALOG_SEED=1
