[Unit]
Description=TOPSHINALAR public catalog outbox delivery (no business writes over HTTP)
After=network-online.target

[Service]
Type=oneshot
User=topshinalar
WorkingDirectory=/opt/topshinalar-bot
EnvironmentFile=/etc/topshinalar-bot.env
ExecStart=/opt/topshinalar-bot/.venv/bin/python catalog_sync.py --db /opt/topshinalar-bot/data/topshinalar.sqlite3 once
NoNewPrivileges=true
CapabilityBoundingSet=
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
RestrictNamespaces=true
RestrictRealtime=true
RestrictSUIDSGID=true
LockPersonality=true
PrivateDevices=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectKernelLogs=true
ProtectControlGroups=true
ProtectClock=true
ProtectHostname=true
SystemCallArchitectures=native
PrivateTmp=true
