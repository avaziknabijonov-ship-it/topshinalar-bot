[Unit]
Description=Verified TOPSHINALAR database backup

[Service]
Type=oneshot
User=topshinalar
Group=topshinalar
WorkingDirectory=/opt/topshinalar
ExecStart=/opt/topshinalar/.venv/bin/python /opt/topshinalar/backup.py --source /var/lib/topshinalar/topshinalar.sqlite3 --directory /var/lib/topshinalar/backups --verify-restore
UMask=0077
NoNewPrivileges=true
CapabilityBoundingSet=
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
RestrictNamespaces=true
RestrictRealtime=true
RestrictSUIDSGID=true
LockPersonality=true
PrivateDevices=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectKernelLogs=true
ProtectControlGroups=true
ProtectClock=true
ProtectHostname=true
SystemCallArchitectures=native
PrivateTmp=true
ProtectHome=true
ProtectSystem=strict
ReadWritePaths=/var/lib/topshinalar
